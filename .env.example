# Copy to .env for local testing. On Railway, add these under the service's Variables.
# Never commit the real .env.

# --- behaviour ---
SHADOW_MODE=true              # true = calculate and log everything, write nothing
APPROVAL_THRESHOLD=1000       # £ change that needs a tick on 'Approve change'
RUN_HOURS=9-17                # London time
RUN_WEEKDAYS_ONLY=true
SEASON=2027
PAYMENT_TERMS_DAYS=14
# ACCOUNT_CODES={"insurance_fee__":"207"}   # override Xero account codes per line type

# --- testing on real deals ---
TEST_EMAIL_TO=                # e.g. alex@samiad.com: all emails, incl. Xero's, go here
ONLY_DEALS=                   # comma-separated deal IDs; blank = all

# --- HubSpot (Service Key or private-app token) ---
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=146042835

# --- Xero (Samiad onboarding app) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=               # printed by scripts/authorise_xero.py
XERO_REFRESH_TOKEN=           # printed by scripts/authorise_xero.py (first run only)

# --- Microsoft 365 (Samiad Onboarding app registration) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE=samiad.sharepoint.com:/sites/HQ
SHAREPOINT_FOLDER=General/Applications/2027
MAIL_FROM=bookings@samiad.com
TEAMS_WEBHOOK_URL=

# --- 50% email links (placeholders until the real email arrives) ---
PRE_ARRIVAL_GUIDE_URL=
PRE_ARRIVAL_PAGE_URL=
ENGLISH_TEST_URL=

# --- optional: Claude writes a 3-line summary on the daily report ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
